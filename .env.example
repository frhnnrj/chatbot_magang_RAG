# ============================================
# OpenRouter LLM Configuration
# ============================================
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ============================================
# Embedding Model Configuration
# ============================================
EMBEDDING_MODEL=Qwen/Qwen3-embedding-0.6B
EMBEDDING_DIM=1024
USE_LOCAL_EMBEDDING=true

# ============================================
# OCR Configuration
# ============================================
OCR_ENGINE=easyocr
OCR_WORKERS=8
PDF_DPI=200

# ============================================
# DocString API Configuration
# ============================================
DOCSTRING_API_KEY=your_docstring_api_key_here
DOCSTRING_BASE_URL=https://extraction-api.nanonets.com/api/v1
DOCSTRING_OUTPUT_FORMAT=markdown
DOCSTRING_TIMEOUT=300

# ============================================
# LightRAG Configuration
# ============================================
LIGHTRAG_MAX_ASYNC_WORKERS=2
LIGHTRAG_TIMEOUT=30

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=rag_system

# ============================================
# Qdrant Vector Database Configuration
# ============================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_MODE=server
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_CHUNKS=chunks
QDRANT_COLLECTION_ENTITIES=entities
QDRANT_COLLECTION_RELATIONSHIPS=relationships
QDRANT_VECTOR_SIZE=1024

# ============================================
# Storage & Processing Configuration
# ============================================
WORKING_DIR=./rag_storage
PDF_DIR=./rag_storage/docs
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K_SEARCH=10
LLM_TEMPERATURE=0.5
