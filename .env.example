# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=rag_system

# ============================================
# Qdrant Configuration
# ============================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_CHUNKS=chunks
QDRANT_COLLECTION_ENTITIES=entities
QDRANT_COLLECTION_RELATIONSHIPS=relationships
QDRANT_VECTOR_SIZE=1024

# ============================================
# Existing Configuration (unchanged)
# ============================================
WORKING_DIR=./rag_storage
OUTPUT_DIR=./output
PARSE_METHOD=auto
PARSER=mineru
DISPLAY_CONTENT_STATS=true

ENABLE_IMAGE_PROCESSING=true
ENABLE_TABLE_PROCESSING=true
ENABLE_EQUATION_PROCESSING=true

TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
PDF_DPI=200

OPENROUTER_API_KEY=your_openrouter_key_here
LLM_MODEL=qwen/qwen-32b-vision
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

DOCSTRING_API_KEY=your_docstring_api_key_here
DOCSTRING_SYNC_ENDPOINT=https://api.docstring.com/extract

LIGHTRAG_TIMEOUT=300
